{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.svg",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)",
          "/i18n/*.json"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api",
      "urls": [
        "https://ekashpersky.xyz/api/**"
      ],
      "cacheConfig": {
        "maxAge": "1d",
        "strategy": "freshness",
        "maxSize": 5,
        "timeout": "1s"
      }
    }
  ],
  "appData": {
    "i18n": {
      "languages": [
        "en",
        "ru"
      ]
    }
  }

}
