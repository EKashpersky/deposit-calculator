{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "deposit-calculator": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/global-styles/styles.css",
              "src/global-styles/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "aot": true,
              "extractLicenses": true,
              "sourceMap": false,
              "optimization": true
            },
            "develop": {
              "optimization": false,
              "namedChunks": true,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "deposit-calculator:build:production"
            },
            "develop": {
              "buildTarget": "deposit-calculator:build:develop"
            }
          },
          "defaultConfiguration": "develop"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "configurations": {
            "develop": {
              "buildTarget": "deposit-calculator:build:develop",
              "include": [
                "**/*.spec.ts",
                "**/*.test.ts"
              ]
            }
          }
        }
      }
    }
  }
}
